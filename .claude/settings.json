{
  "permissions": {
    "allow": [
      "Bash(xcodebuild *)",
      "Bash(xcrun simctl *)",
      "Bash(swift *)",
      "Bash(swiftlint *)",
      "Bash(swift-format *)",
      "Bash(find * -name *.swift*)",
      "Bash(wc -l *)",
      "Bash(ls *)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)"
    ]
  },
  "env": {
    "XCODE_SCHEME": "agile-self",
    "SIMULATOR_NAME": "iPhone 16"
  }
}
